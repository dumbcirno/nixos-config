// Glass effect — mirrors Hyprland blur/decoration settings
blur {
    passes 4
    offset 3.0
    noise 0.01
    saturation 1.2
}

prefer-no-csd

window-rule {
    match app-id=".*"
    geometry-corner-radius 14
    clip-to-geometry true
}

layer-rule {
    match namespace="^rofi$"
    geometry-corner-radius 14
    background-effect {
        xray false
        blur true
        noise 0.01
        saturation 1.2
    }
}

layer-rule {
    match namespace="^waybar$"
    match layer="top"
    geometry-corner-radius 14
    background-effect {
        xray false
        blur true
        noise 0.01
        saturation 1.2
    }
}

layer-rule {
    match layer="top"
    match layer="overlay"
    background-effect {
        xray false
    }
}

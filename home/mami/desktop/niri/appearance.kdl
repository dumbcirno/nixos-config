// Glass effect — mirrors Hyprland blur/decoration settings
blur {
    passes 4
    offset 3.0
    noise 0.01
    saturation 1.2
}

layout {
    border {
        width 4
        active-color "#000000"
        inactive-color "#ffffff"
    }
}

prefer-no-csd

window-rule {
    match app-id=".*"
    geometry-corner-radius 14
    clip-to-geometry true
}

layer-rule {
    match namespace="^walker"
    geometry-corner-radius 14
    background-effect {
        xray false
        blur true
        noise 0.01
        saturation 1.2
    }
}

layer-rule {
    match namespace="^waybar$"
    geometry-corner-radius 14
    place-within-backdrop true

    background-effect {
        xray false
        blur true
        noise 0.01
        saturation 1.2
    }

    popups {
        geometry-corner-radius 6
        background-effect {
            blur true
        }
    }
}

layer-rule {
    match layer="top"
    match layer="overlay"
    background-effect {
        xray false
    }
}
